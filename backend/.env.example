# BloodPing Backend Configuration

# Database connection URL
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Supabase Auth configuration
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Email / SMTP Configuration (Gmail SMTP or any custom SMTP)
# For Gmail: Use your Gmail address and a 16-character Google App Password (not your personal account password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_TLS=True
EMAILS_FROM_EMAIL=your-email@gmail.com
EMAILS_FROM_NAME=BloodPing
FRONTEND_URL=https://bloodping.vercel.app